NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Development uses pk_test_/sk_test_ keys. Both MUST come from the same Clerk
# instance or session refresh fails with an infinite redirect loop.
# Production requires a Clerk production instance: create it, add the domain
# and its DNS records, then deploy with pk_live_/sk_live_ keys. The orange
# "Development mode" badge is attached to test-key instances and disappears
# only when live keys are in use.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# These four are also set explicitly on <ClerkProvider> in src/app/layout.tsx.
# If either sign-in or sign-up URL is wrong, Clerk falls back to its hosted
# Account Portal on accounts.dev instead of staying inside this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

GOOGLE_GENERATIVE_AI_API_KEY=

# Google sign-in
#
# 1. Turn on the Google connection in Clerk (User & Authentication > SSO).
# 2. Add http://localhost:3000 and the production origin to the allowed
#    origins for the instance. The OAuth flow returns to /sso-callback in
#    this app, which is a real route — do not point it at accounts.dev.
# 3. On a production instance, put the app's own Client ID and Secret from
#    the Google Cloud console in, with the Clerk redirect URI Clerk shows
#    you. Development instances borrow Clerk's shared credentials.

# Set on the Convex deployment, not here, because Convex functions read them:
#
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<app>.clerk.accounts.dev
#   npx convex env set BOOTSTRAP_ADMIN_EMAIL you@example.com
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...
#   npx convex env set GOOGLE_GENERATIVE_AI_API_KEY <key>
#   npx convex env set GROQ_API_KEY <key>
#
# The Clerk JWT template named "convex" must carry an email claim:
#
#   { "aud": "convex", "email": "{{user.primary_email_address}}" }
#
# The server matches invitations against that claim, never against an
# address sent up by the browser. Without it nobody can be given a role and
# the first administrator cannot be claimed.

# Account deletion
#
# Add a Clerk webhook pointing at
#
#   <NEXT_PUBLIC_CONVEX_SITE_URL>/clerk-webhook
#
# subscribed to user.deleted and user.updated, and put its signing secret in
# CLERK_WEBHOOK_SECRET above. Without it, an account deleted from the Clerk
# dashboard or another device stays listed in Administration until somebody
# reconciles by hand. Deleting from inside the app does not depend on it.

# Account Portal
#
# In the Clerk dashboard, Account Portal > Redirects, point every path at
# this application (/sign-in, /sign-up, /account, and / after sign-out).
# The instance defaults send people to <slug>.accounts.dev, which is what
# links inside Clerk's own security emails follow.
