DATABASE_URL="postgresql://user:password@host/akhra?sslmode=require"
DATABASE_POOL_MAX="5"
# openssl rand -base64 48
INVITE_SIGNING_SECRET=""
INVITE_TTL_HOURS="72"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk dashboard → Configure → API keys (free Hobby plan). Leave empty to run without sign-in:
# public pages, anonymous reporting and the tracker still work.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Clerk dashboard → Webhooks → endpoint /api/webhooks/clerk (needed once deployed)
CLERK_WEBHOOK_SIGNING_SECRET=""
# openssl rand -base64 32 — the scheduler sends this to /api/cron/maintenance
CRON_SECRET=""

AI_PROVIDER_CHAIN="gemini,groq,tfidf"
AI_TIMEOUT_MS="6000"
AI_BREAKER_THRESHOLD="3"
AI_BREAKER_COOLDOWN_MS="60000"
# aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
# console.groq.com/keys (free tier)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

MAIL_DRIVER="console"
# resend.com/api-keys (free: 3,000 emails/month; needs a verified domain to email others)
RESEND_API_KEY=""
MAIL_FROM="Akhra <onboarding@resend.dev>"

FILE_STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR=".uploads"
MAX_UPLOAD_BYTES="10485760"
# Vercel → Storage → Blob (free on Hobby up to 1 GB); only for FILE_STORAGE_DRIVER=blob
BLOB_READ_WRITE_TOKEN=""

RATE_LIMIT_SUBMISSIONS_PER_HOUR="5"
# Cloudflare dashboard → Turnstile (free). Leave both empty to skip the human check locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
LOG_LEVEL="info"
ALLOW_SEED="true"

# Tests & tooling (read by test runners, never by the web app)
TEST_DATABASE_URL=""
E2E_BASE_URL=""
