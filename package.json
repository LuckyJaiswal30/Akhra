{
  "name": "akhra",
  "private": true,
  "version": "0.1.0",
  "description": "Akhra — civic innovation platform connecting citizens, universities, industry and government in Jharkhand",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @akhra/web dev",
    "build": "pnpm --filter @akhra/web build",
    "start": "pnpm --filter @akhra/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm --filter @akhra/web test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @akhra/db generate",
    "db:migrate": "pnpm --filter @akhra/db migrate",
    "db:studio": "pnpm --filter @akhra/db studio",
    "db:seed": "pnpm --filter @akhra/db seed",
    "db:fingerprints": "pnpm --filter @akhra/db backfill-fingerprints",
    "check:no-hardcoded-urls": "node scripts/check-no-hardcoded-urls.mjs",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:no-hardcoded-urls && pnpm --filter @akhra/web contrast && pnpm build",
    "admin:bootstrap": "pnpm --filter @akhra/db run bootstrap-super-admin",
    "email:preview": "pnpm --filter @akhra/web exec tsx scripts/preview-emails.tsx",
    "email:clerk": "pnpm --filter @akhra/web exec tsx scripts/clerk-email-templates.tsx",
    "cron:local": "curl -fsS -X POST -H \"authorization: Bearer $CRON_SECRET\" \"${NEXT_PUBLIC_APP_URL:-http://localhost:3000}/api/cron/maintenance\"",
    "clerk:demo-users": "pnpm --filter @akhra/db clerk-demo-users"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
